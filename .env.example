DATABASE_URL="postgresql://user:password@localhost:5432/darmasr?schema=public"

# Secret used to sign session JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# Optional: S3-compatible object storage for listing photos (AWS S3,
# Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze B2, ...). If any of
# S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY is unset, uploads fall
# back to local disk at public/uploads (fine for local development).
# S3_BUCKET="darmasr-listings"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="false"
# S3_PUBLIC_URL_BASE="https://media.example.com"

# Optional: promo video generation via a self-hosted MoneyPrinterTurbo server
# (https://github.com/harry0703/MoneyPrinterTurbo). When MONEYPRINTER_API_URL is
# unset, the "Promo video" panel is hidden. The MoneyPrinterTurbo server needs
# a Pexels API key in its config.toml (pexels_api_keys); no LLM key is needed
# because DarMasr sends a ready-made script.
# MONEYPRINTER_API_URL="http://localhost:8080"
# MONEYPRINTER_API_KEY=""            # must match `api_key` in its config.toml, if set
# MONEYPRINTER_VIDEO_ASPECT="9:16"   # 9:16 | 16:9 | 1:1
# MONEYPRINTER_VOICE_EN="en-US-AriaNeural-Female"
# MONEYPRINTER_VOICE_AR="ar-EG-SalmaNeural-Female"
# MONEYPRINTER_FONT="MicrosoftYaHeiBold.ttc"
# MONEYPRINTER_ARABIC_FONT=""        # an Arabic-capable font file in its resource/fonts; enables Arabic subtitles
