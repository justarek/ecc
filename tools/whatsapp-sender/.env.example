# Copy this file to .env and fill in the values. Never commit .env.

# --- Meta / WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup) ---
# Permanent System User access token with whatsapp_business_messaging permission
WA_TOKEN=
# "Phone number ID" of +20 103 004 0179 (NOT the phone number itself)
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v23.0

# --- Message ---
# "template" (default): uses an approved template with an IMAGE header and {{1}} = name in the body.
#    Required by WhatsApp to message people who haven't written to you in the last 24h.
# "session": sends the image with a free-form caption. Only delivered to people who messaged
#    your business number within the last 24 hours.
MODE=template
WA_TEMPLATE_NAME=personal_greeting
WA_TEMPLATE_LANG=ar
# Used only in session mode. {name} is replaced with the contact's name.
CAPTION=أهلاً {name} 👋 عندنا لك مفاجأة خاصة!
# Used when a row has no name.
FALLBACK_NAME=عميلنا العزيز

# --- Input ---
EXCEL_PATH=./contacts.xlsx
IMAGE_PATH=./image.jpg
# Applied to local numbers like 01012345678 -> 201012345678
DEFAULT_COUNTRY_CODE=20

# --- Pacing ---
# Pause between messages (ms). Keep this slow at first to protect your number's quality rating.
DELAY_MS=1500
